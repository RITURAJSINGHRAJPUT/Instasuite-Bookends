# Copy to `.env` and fill in. `.env` is gitignored; this template is committed.

# --- Supabase (same project as the web app) ---
# Service-role key — it bypasses RLS to read/update the outbox. Keep it secret; this
# machine now holds a powerful credential.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Where confirmations go ---
# Reservation-team WhatsApp GROUP id. Leave blank on first run; the worker prints every
# group id on startup — copy the right one here and restart. (Looks like 1203...@g.us)
WA_GROUP_ID=

# Staff phone numbers, comma-separated, E.164 WITHOUT the leading + (e.g. 919876543210).
# Leave blank to send to the group only.
WA_STAFF_NUMBERS=

# --- Tuning ---
POLL_MS=5000
MAX_ATTEMPTS=3

# Where whatsapp-web.js stores its logged-in session (survives restarts on this disk).
SESSION_PATH=./.wwebjs_auth
