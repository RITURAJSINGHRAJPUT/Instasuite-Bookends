# Copy to `.env` and fill in. `.env` is gitignored; this template is committed.
#
# NOTE: when you run the worker from inside the repo it also reads the repo-root
# `.env` / `.env.local` automatically and accepts NEXT_PUBLIC_SUPABASE_URL, so you
# usually DON'T need this file locally. Create it on a standalone machine (VPS) where
# the repo-root env isn't present, or to override any value below.

# --- Supabase (same project as the web app) ---
# Service-role key — it bypasses RLS to read/update the outbox. Keep it secret; this
# machine now holds a powerful credential. (URL may also be provided as
# NEXT_PUBLIC_SUPABASE_URL, which is how the app's env names it.)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Where confirmations go (FALLBACK) ---
# Destinations are normally set per business on the dashboard's WhatsApp page. These env
# values are only used for a business that has NO destination configured there, so you
# can leave them blank once you've set things up in the dashboard.
#
# Reservation-team WhatsApp GROUP id. The worker prints every group id on startup —
# paste the right one into the dashboard (or here as a fallback). (Looks like 1203...@g.us)
WA_GROUP_ID=

# Staff phone numbers, comma-separated, E.164 WITHOUT the leading + (e.g. 919876543210).
WA_STAFF_NUMBERS=

# --- Tuning ---
POLL_MS=5000
MAX_ATTEMPTS=3

# Where whatsapp-web.js stores its logged-in session (survives restarts on this disk).
SESSION_PATH=./.wwebjs_auth
